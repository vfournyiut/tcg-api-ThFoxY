generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PokemonType {
  Normal
  Fire
  Water
  Electric
  Grass
  Ice
  Fighting
  Poison
  Ground
  Flying
  Psychic
  Bug
  Rock
  Ghost
  Dragon
  Dark
  Steel
  Fairy
}

model Card {
  id            Int         @id @default(autoincrement())
  name          String
  hp            Int
  attack        Int
  type          PokemonType
  pokedexNumber Int
  imgUrl        String?
  // Relation inverse vers la table de jonction
  decks         DeckCard[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model User {
  id            Int         @id @default(autoincrement())
  username      String      @unique
  email         String      @unique
  password      String
  decks         Deck[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Deck {
  id            Int         @id @default(autoincrement())
  name          String
  // Relation N:1 vers User
  user          User        @relation(fields: [userId], references: [id])
  userId        Int
  // Relation vers la table de jonction
  cards         DeckCard[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model DeckCard {
  id            Int         @id @default(autoincrement())
  // Relation N:M vers Deck
  deck          Deck        @relation(fields: [deckId], references: [id])
  deckId        Int
  // Relation N:M vers Card
  card          Card        @relation(fields: [cardId], references: [id])
  cardId        Int
}
